@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/fizmoDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/fizmoTargets.cmake")

set(fizmo_static_FOUND FALSE)
set(fizmo_shared_FOUND FALSE)
if(TARGET fizmo::fizmo_static)
    set(fizmo_static_FOUND TRUE)
endif()
if(TARGET fizmo::fizmo_shared)
    set(fizmo_shared_FOUND TRUE)
endif()

if(NOT TARGET fizmo::fizmo)
    if(NOT DEFINED FIZMO_SHARED)
        set(FIZMO_SHARED ${BUILD_SHARED_LIBS})
    endif()
    if("shared" IN_LIST fizmo_FIND_COMPONENTS AND NOT "static" IN_LIST fizmo_FIND_COMPONENTS)
        set(FIZMO_SHARED ON)
    elseif("static" IN_LIST fizmo_FIND_COMPONENTS AND NOT "shared" IN_LIST fizmo_FIND_COMPONENTS)
        set(FIZMO_SHARED OFF)
    endif()

    if(FIZMO_SHARED AND TARGET fizmo::fizmo_shared)
        set(_fizmo_default fizmo::fizmo_shared)
    elseif(TARGET fizmo::fizmo_static)
        set(_fizmo_default fizmo::fizmo_static)
    else()
        set(_fizmo_default fizmo::fizmo_shared)
    endif()

    add_library(fizmo::fizmo INTERFACE IMPORTED)
    set_target_properties(fizmo::fizmo PROPERTIES INTERFACE_LINK_LIBRARIES ${_fizmo_default})
    unset(_fizmo_default)
endif()

check_required_components(fizmo)
