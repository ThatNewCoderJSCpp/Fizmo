file(GLOB_RECURSE FIZMO_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../Source/*.cpp")
if(APPLE)
    file(GLOB_RECURSE FIZMO_OBJCXX_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../Source/*.mm")
    list(APPEND FIZMO_SOURCES ${FIZMO_OBJCXX_SOURCES})
    set_source_files_properties(${FIZMO_OBJCXX_SOURCES} PROPERTIES
        COMPILE_OPTIONS "-fobjc-arc"
        SKIP_PRECOMPILE_HEADERS ON
        SKIP_UNITY_BUILD_INCLUSION ON)
endif()

set(FIZMO_COMPONENTS core random crypto string statistics numerics chemistry physics symbolic time collections system util net db graphics)

set(FIZMO_COMPONENT_LINK_ORDER net db graphics crypto string statistics physics chemistry numerics symbolic time collections system util random core)

set(FIZMO_COMPONENT_DIRS_core        Multiprecision)
set(FIZMO_COMPONENT_DIRS_random      Random)
set(FIZMO_COMPONENT_DIRS_crypto      Crypto)
set(FIZMO_COMPONENT_DIRS_string      String)
set(FIZMO_COMPONENT_DIRS_statistics  Statistics)
set(FIZMO_COMPONENT_DIRS_numerics    Numerics)
set(FIZMO_COMPONENT_DIRS_chemistry   Chemistry)
set(FIZMO_COMPONENT_DIRS_physics     Physics)
set(FIZMO_COMPONENT_DIRS_symbolic    "Symbolic Math")
set(FIZMO_COMPONENT_DIRS_time        Time)
set(FIZMO_COMPONENT_DIRS_collections Arrays)
set(FIZMO_COMPONENT_DIRS_system      System)
set(FIZMO_COMPONENT_DIRS_util        "Util Hpp")
set(FIZMO_COMPONENT_DIRS_net         Networking)
set(FIZMO_COMPONENT_DIRS_db          Database)
set(FIZMO_COMPONENT_DIRS_graphics    Android Colors GPU Game Graphics Images Input OpenGL Text UI Vulkan Windows)

set(FIZMO_COMPONENT_FILES_graphics System/hot_reload.cpp)
set(FIZMO_COMPONENT_FILES_core Arrays/common/memory/windows/allocator.cpp)

set(FIZMO_COMPONENT_USES_core        "")
set(FIZMO_COMPONENT_USES_random      core)
set(FIZMO_COMPONENT_USES_crypto      random)
set(FIZMO_COMPONENT_USES_string      random)
set(FIZMO_COMPONENT_USES_statistics  core)
set(FIZMO_COMPONENT_USES_numerics    core)
set(FIZMO_COMPONENT_USES_chemistry   core)
set(FIZMO_COMPONENT_USES_physics     core)
set(FIZMO_COMPONENT_USES_symbolic    core)
set(FIZMO_COMPONENT_USES_time        core)
set(FIZMO_COMPONENT_USES_collections core)
set(FIZMO_COMPONENT_USES_system      core)
set(FIZMO_COMPONENT_USES_util        core)
set(FIZMO_COMPONENT_USES_net         crypto util)
set(FIZMO_COMPONENT_USES_db          crypto)
set(FIZMO_COMPONENT_USES_graphics    system util string)

foreach(_fizmo_component IN LISTS FIZMO_COMPONENTS)
    set(FIZMO_COMPONENT_SOURCES_${_fizmo_component} "")
endforeach()

get_filename_component(_fizmo_source_root "${CMAKE_CURRENT_LIST_DIR}/../Source" ABSOLUTE)

foreach(_fizmo_source IN LISTS FIZMO_SOURCES)
    get_filename_component(_fizmo_source "${_fizmo_source}" ABSOLUTE)
    file(RELATIVE_PATH _fizmo_rel "${_fizmo_source_root}" "${_fizmo_source}")
    string(REGEX REPLACE "/.*$" "" _fizmo_top "${_fizmo_rel}")
    set(_fizmo_owner "")

    foreach(_fizmo_component IN LISTS FIZMO_COMPONENTS)
        if(_fizmo_rel IN_LIST FIZMO_COMPONENT_FILES_${_fizmo_component})
            set(_fizmo_owner ${_fizmo_component})
            break()
        endif()
    endforeach()

    if(NOT _fizmo_owner)
        foreach(_fizmo_component IN LISTS FIZMO_COMPONENTS)
            if(_fizmo_top IN_LIST FIZMO_COMPONENT_DIRS_${_fizmo_component})
                set(_fizmo_owner ${_fizmo_component})
                break()
            endif()
        endforeach()
    endif()

    if(NOT _fizmo_owner)
        message(FATAL_ERROR "fizmo: Source/${_fizmo_rel} is not part of any component. Add its folder to a FIZMO_COMPONENT_DIRS_<component> list in cmake/fizmoSources.cmake.")
    endif()

    list(APPEND FIZMO_COMPONENT_SOURCES_${_fizmo_owner} "${_fizmo_source}")
endforeach()

unset(_fizmo_source_root)
unset(_fizmo_source)
unset(_fizmo_rel)
unset(_fizmo_top)
unset(_fizmo_owner)
unset(_fizmo_component)
